		"@hookform/resolvers": "^7.0.6",
		"better-auth": "^1.7.23",
		"class-variance-authority": "^0.7.1",
		"cn": "^0.5.2",
		"drizzle-orm": "^0.45.4",
		"lucide-react": "^1.73.0",
		"next": "16.4.6",
		"next-themes": "^0.4.6",
		"nodemailer": "^10.5.0",
		"pino": "^10.4.0",
		"postgres": "^4.1.1",
