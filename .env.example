# База данных (Postgres 17 из docker-compose.dev.yml; хост-порт 5560 — 5432 зарезервирован WinNAT)
DATABASE_URL=postgresql://postgres:postgres@localhost:5560/food_delivery

# S3-совместимое хранилище (MinIO из docker-compose.dev.yml)
S3_ENDPOINT=http://localhost:9000
S3_KEY=minioadmin
S3_SECRET=minioadmin
S3_BUCKET=food-delivery

# Auth (better-auth): сгенерировать — openssl rand -base64 32
AUTH_SECRET=

# Доверенный origin better-auth (prod strict: без него «Invalid origin» на auth-POST,
# §5.32-а). Обязателен в prod-рантайме; в dev — дефолт http://localhost:3000
BETTER_AUTH_URL=http://localhost:3000

# Email-транспорт (Mailpit в dev: SMTP :1025, UI :8025).
# Пусто/не задано → транспорт падает в консоль-заглушку
SMTP_HOST=localhost
SMTP_PORT=1025

# Демо-режимы
DEMO_SMS_OTP_CODE=1111
# Автоджоба статусов: true — заказы «оживают» без админки (dev on / prod off:
# prod-compose флаг не задаёт → off). Свип просрочки окна оплаты работает
# всегда независимо от флага
DEMO_AUTO_STATUS=true
# Тик автоджобы, мс (кламп ≥ 5000): свип + продвижение заказов на один шаг
DEMO_AUTO_STATUS_INTERVAL=60000
# Демо-доля отмен заведением: рол в точке created→preparing, только on_receipt (0..1)
DEMO_AUTO_CANCEL_RATE=0.1

# Оплата (мок-провайдер этапа 9)
PAYMENT_PROVIDER=mock
# Секрет HMAC-подписи webhook'а провайдера — сгенерировать: openssl rand -base64 32
PAYMENTS_WEBHOOK_SECRET=
# Окно оплаты онлайн-заказа (минуты): просрочка → cancelled_by_timeout
PAYMENT_WINDOW_MINUTES=5

# Real-time чат (этап 6): WS-шлюз — отдельный процесс (dev: `pnpm dev:gateway` на хосте :3001)
# NEXT_PUBLIC_* — первый в проекте: инлайнится в бандл ТОЛЬКО на build (§5.32-г),
# рантайм-инъекции нет → в Docker передаётся ARG'ом на build-стадии
NEXT_PUBLIC_WS_URL=ws://localhost:3001
# Общий секрет Next (internal-роут чата) и ws-gateway (релей записей); dev — любое значение
INTERNAL_API_SECRET=

# ─── Ops (этап 11) ───────────────────────────────────────────────────────────
# Уровень структурных логов pino (trace|debug|info|warn|error|fatal); дефолт info
LOG_LEVEL=info
#
# Валидация env (lib/env.ts, zod): dev/build — lenient (фолбэки), prod-рантайм
# контейнера — strict: ошибка/опечатка → читаемый список → exit(1) на старте.
# Prod-required: DATABASE_URL, AUTH_SECRET, INTERNAL_API_SECRET,
# PAYMENTS_WEBHOOK_SECRET, S3_*, BETTER_AUTH_URL (см. lib/env.ts LENIENT_FALLBACKS).
